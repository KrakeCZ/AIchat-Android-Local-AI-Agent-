        <!-- GEN_Studio — Video & Image Generation Studio (Offline Multi-Engine DiT) -->
        <activity android:name=".agent.ui.studio.genstudio.GenStudioActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden" android:theme="@style/Theme.AiChatSample" android:label="GEN Studio" />

        <activity android:name=".ui.onboarding.RestrictedSettingsGuideActivity" android:label="OmezenĂ© nastavenĂ­" android:theme="@style/Theme.AppCompat.Light.Dialog.Alert" />

        <!-- IrisMotion Calibration Activity â€” fullscreen, immersive (ĹľĂˇdnĂ˝ ActionBar) -->
        <activity android:name=".agent.irismotion.CalibrationActivity" android:label="IrisMotion Kalibrace" android:exported="false" android:theme="@style/Theme.AppCompat.NoActionBar" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" />

        <!-- Foreground Service pro Transcript System Audio (MediaProjection host) -->
        <service android:name=".agent.perception.TranscriptForegroundService" android:enabled="true" android:exported="false" android:foregroundServiceType="mediaProjection">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="com.example.llama.agent.transcript_system_audio" />
        </service>

        <!-- FĂˇze C: Foreground Service pro batch SRT pĹ™epis (audio/video na pozadĂ­) -->
        <!-- foregroundServiceType=dataSync: Android 14+ â€” offline ML inference = data processing -->
        <service android:name=".srt.SrtTranscriptionService" android:enabled="true" android:exported="false" android:foregroundServiceType="dataSync" />

        <!-- Dual-Pipeline Export Service: vypalovĂˇnĂ­ titulkĹŻ (Media3 GPU + FFmpeg/libass C++) -->
        <!-- foregroundServiceType=mediaProcessing: Android 14 (API 34+) â€” offline video processing -->
        <service android:name=".srt.export.SubtitleExportService" android:enabled="true" android:exported="false" android:foregroundServiceType="mediaProcessing" />

        <!-- GEN_Studio: Foreground Service pro bezpečné generování videa a obrazu na pozadí (DataSync + WakeLock) -->
        <service android:name=".agent.ui.studio.genstudio.service.GenStudioForegroundService"
