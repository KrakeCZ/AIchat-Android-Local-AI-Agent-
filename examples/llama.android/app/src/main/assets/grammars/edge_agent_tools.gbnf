# ============================================================================
# SOTA 2026/2027 Edge-AnythingLLM Agent Grammar for llama.cpp (ai_chat.cpp)
# Enforces strict tool-call JSON schemas inside <tool_call>...</tool_call>
# ============================================================================

root ::= think-block? (tool-call-block | direct-answer)

think-block ::= "<think>" "\n"? think-text "</think>" "\n"*
think-text  ::= ([^<] | "<" [^/])*

direct-answer ::= [^\x00<] [^\x00]*

tool-call-block ::= "<tool_call>" "\n"? tool-dispatch "\n"? "</tool_call>" ws

tool-dispatch ::=
    call-web-search |
    call-academic-patent-search |
    call-browser-research-page |
    call-browser-open |
    call-browser-scroll |
    call-browser-click |
    call-browser-find |
    call-browser-back |
    call-rag-search |
    call-file-write |
    call-file-read |
    call-file-list |
    call-file-delete |
    call-realtime-status

# 1. web_search
call-web-search ::=
    "{" ws "\"name\"" ws ":" ws "\"web_search\"" ws "," ws "\"arguments\"" ws ":" ws args-web-search "}"
args-web-search ::=
    "{" ws "\"query\"" ws ":" ws string ("," ws "\"max_results\"" ws ":" ws int-small)? "}" ws

# 2. academic_patent_search (Studie, preprinty, patenty)
call-academic-patent-search ::=
    "{" ws "\"name\"" ws ":" ws "\"academic_patent_search\"" ws "," ws "\"arguments\"" ws ":" ws args-academic-search "}"
args-academic-search ::=
    "{" ws "\"query\"" ws ":" ws string ("," ws "\"category\"" ws ":" ws category-enum)? ("," ws "\"max_results\"" ws ":" ws int-small)? "}" ws
category-enum ::= ("\"academic\"" | "\"patent\"" | "\"web\"") ws

# 3. browser_research_page (Autonomni Browser Subagent - Ruce Agenta)
call-browser-research-page ::=
    "{" ws "\"name\"" ws ":" ws "\"browser_research_page\"" ws "," ws "\"arguments\"" ws ":" ws args-browser-research "}"
args-browser-research ::=
    "{" ws "\"url\"" ws ":" ws http-url-string "," ws "\"focus_query\"" ws ":" ws string ("," ws "\"max_tokens\"" ws ":" ws int-tokens)? "}" ws

# 4. browser_open (Stavovy prohlizec)
call-browser-open ::=
    "{" ws "\"name\"" ws ":" ws "\"browser_open\"" ws "," ws "\"arguments\"" ws ":" ws args-browser-open "}"
args-browser-open ::=
    "{" ws "\"url\"" ws ":" ws http-url-string ("," ws "\"tokens_per_viewport\"" ws ":" ws int-tokens)? "}" ws

# 5. browser_scroll
call-browser-scroll ::=
    "{" ws "\"name\"" ws ":" ws "\"browser_scroll\"" ws "," ws "\"arguments\"" ws ":" ws args-browser-scroll "}"
args-browser-scroll ::=
    "{" ws "\"direction\"" ws ":" ws scroll-dir-enum ("," ws "\"steps\"" ws ":" ws int-small)? "}" ws
scroll-dir-enum ::= ("\"down\"" | "\"up\"" | "\"top\"" | "\"bottom\"") ws

# 6. browser_click
call-browser-click ::=
    "{" ws "\"name\"" ws ":" ws "\"browser_click\"" ws "," ws "\"arguments\"" ws ":" ws args-browser-click "}"
args-browser-click ::=
    "{" ws "\"link_index\"" ws ":" ws int-link "}" ws

# 7. browser_find
call-browser-find ::=
    "{" ws "\"name\"" ws ":" ws "\"browser_find\"" ws "," ws "\"arguments\"" ws ":" ws args-browser-find "}"
args-browser-find ::=
    "{" ws "\"keyword\"" ws ":" ws string "}" ws

# 8. browser_back
call-browser-back ::=
    "{" ws "\"name\"" ws ":" ws "\"browser_back\"" ws "," ws "\"arguments\"" ws ":" ws empty-obj "}"

# 9. rag_search (SQLite FTS5 Hybrid RAG: user_documents_fts + web_archive_fts)
call-rag-search ::=
    "{" ws "\"name\"" ws ":" ws "\"rag_search\"" ws "," ws "\"arguments\"" ws ":" ws args-rag-search "}"
args-rag-search ::=
    "{" ws "\"query\"" ws ":" ws string ("," ws "\"top_k\"" ws ":" ws int-small)? "}" ws

# 10. file_write (Bezpecny zapis souboru v sandboxu)
call-file-write ::=
    "{" ws "\"name\"" ws ":" ws "\"file_write\"" ws "," ws "\"arguments\"" ws ":" ws args-file-write "}"
args-file-write ::=
    "{" ws "\"path\"" ws ":" ws safe-path-string "," ws "\"content\"" ws ":" ws string ("," ws "\"append\"" ws ":" ws boolean)? "}" ws

# 11. file_read
call-file-read ::=
    "{" ws "\"name\"" ws ":" ws "\"file_read\"" ws "," ws "\"arguments\"" ws ":" ws args-file-read "}"
args-file-read ::=
    "{" ws "\"path\"" ws ":" ws safe-path-string ("," ws "\"max_chars\"" ws ":" ws int-chars)? ("," ws "\"offset\"" ws ":" ws int-offset)? "}" ws

# 12. file_list
call-file-list ::=
    "{" ws "\"name\"" ws ":" ws "\"file_list\"" ws "," ws "\"arguments\"" ws ":" ws empty-obj "}"

# 13. file_delete
call-file-delete ::=
    "{" ws "\"name\"" ws ":" ws "\"file_delete\"" ws "," ws "\"arguments\"" ws ":" ws args-file-delete "}"
args-file-delete ::=
    "{" ws "\"path\"" ws ":" ws safe-path-string "}" ws

# 14. realtime_status
call-realtime-status ::=
    "{" ws "\"name\"" ws ":" ws "\"realtime_status\"" ws "," ws "\"arguments\"" ws ":" ws empty-obj "}"

# ============================================================================
# PRIMITIVNI DATOVE TYPY A OMEZENI (ZERO-ERROR CONSTRAINTS)
# ============================================================================

empty-obj ::= "{" ws "}" ws

http-url-string ::=
    "\"http" "s"? "://" ([^"\\\x7F\x00-\x1F ])+ "\"" ws

safe-path-string ::=
    "\"" [a-zA-Z0-9_] [a-zA-Z0-9_.\-/]{0,60} "\"" ws

string ::=
    "\"" (
        [^"\\\x7F\x00-\x1F] |
        "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4})
    )* "\"" ws

boolean    ::= ("true" | "false") ws
int-small  ::= [1-9] [0-9]? ws
int-link   ::= [1-9] [0-9]? ws
int-tokens ::= [1-9] [0-9]{2,3} ws
int-chars  ::= [1-9] [0-9]{2,4} ws
int-offset ::= ("0" | [1-9] [0-9]{0,6}) ws

ws ::= | " " | "\n" [ \t]{0,8}