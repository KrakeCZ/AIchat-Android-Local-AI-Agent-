<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:fitsSystemWindows="true" android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="24dp">

        <com.google.android.material.appbar.AppBarLayout android:id="@+id/appBarLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#121212" app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar_audio_studio" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="🎙️ Audio Studio" app:titleTextColor="@android:color/white" app:navigationIcon="@android:drawable/ic_menu_revert" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Karta 1: DSP Záznam & Muxing -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_dsp_record" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" app:cardBackgroundColor="#121212" app:cardCornerRadius="16dp" app:strokeColor="#2E7D32" app:strokeWidth="1dp" app:layout_constraintTop_toBottomOf="@id/appBarLayout">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">

                <!-- Timer -->
                <TextView android:id="@+id/tv_record_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00:00" android:textColor="#FFFFFF" android:textSize="56sp" android:textStyle="bold" android:fontFamily="sans-serif-light" android:layout_marginBottom="16dp" />

                <!-- Zdroj Zvuku -->
                <Spinner android:id="@+id/spinner_audio_source" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="16dp" android:backgroundTint="@android:color/white" />

                <!-- VU Meter & Theme Switch -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="24dp">
                    <com.example.llama.ui.views.ProfessionalVuMeterView android:id="@+id/progress_vu_meter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="20dp" android:layout_marginEnd="16dp" />
                    <ImageButton android:id="@+id/btn_vu_theme" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_manage" android:background="?attr/selectableItemBackgroundBorderless" app:tint="#888888" android:contentDescription="VU Meter Theme" />
                </LinearLayout>

                <!-- Record Button (kruhový FAB) -->
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_record_master" android:layout_width="96dp" android:layout_height="96dp" android:layout_marginBottom="16dp" app:backgroundTint="#D32F2F" app:cornerRadius="48dp" app:icon="@android:drawable/ic_btn_speak_now" app:iconSize="48dp" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="#FFFFFF" android:insetTop="0dp" android:insetBottom="0dp" />

                <!-- Pause / Stop tlačítka (viditelná až po zahájení nahrávání) -->
                <LinearLayout android:id="@+id/layout_record_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="24dp" android:visibility="gone">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_pause_dictaphone" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="8dp" android:text="⏸ Pauza" android:textColor="#FFA000" app:strokeColor="#FFA000" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_stop_dictaphone" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="⏹ Stop" android:textColor="#D32F2F" app:strokeColor="#D32F2F" />
                </LinearLayout>


                <!-- Live STT Toggle & Transcript -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Okamžitý Přepis (Live STT)" android:textColor="#FFFFFF" android:textSize="16sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_live_stt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" app:useMaterialThemeColors="false" app:thumbTint="#4CAF50" app:trackTint="#1B5E20" />
                </LinearLayout>

                <!-- SRT titulky z diktafonu (D1) -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🎬 Generovat SRT titulky" android:textColor="#CCCCCC" android:textSize="14sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_dictaphone_srt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" app:useMaterialThemeColors="false" app:thumbTint="#2196F3" app:trackTint="#0D47A1" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="12dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ASR Engine:" android:textColor="#00BCD4" android:textSize="14sp" android:layout_marginEnd="8dp" />

                    <Spinner android:id="@+id/spinner_transcript_engine" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="#00BCD4" />
                </LinearLayout>

                <!-- ── HW Akcelerátor (ASR) ── -->
                <TextView android:id="@+id/tv_asr_accelerator_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎙 ASR Akcelerátor (Whisper/Sherpa)" android:textColor="#00BCD4" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="0dp" android:layout_marginBottom="4dp" />

                <com.google.android.material.chip.ChipGroup android:id="@+id/chipgroup_asr_accelerator" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" android:layout_marginBottom="8dp">

                    <com.google.android.material.chip.Chip android:id="@+id/chip_asr_accel_cpu" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU" android:textSize="11sp" />

                    <com.google.android.material.chip.Chip android:id="@+id/chip_asr_accel_gpu" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPU" android:visibility="gone" android:textSize="11sp" />

                    <com.google.android.material.chip.Chip android:id="@+id/chip_asr_accel_npu" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NNAPI" android:textSize="11sp" />
                </com.google.android.material.chip.ChipGroup>


                <!-- ── HW Akcelerátor (AI modely) ── -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🤖 AI Akcelerátor (MediaPipe/Tensor)" android:textColor="#00BCD4" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="0dp" android:layout_marginBottom="4dp" />

                <com.google.android.material.chip.ChipGroup android:id="@+id/chipgroup_accelerator" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" android:layout_marginBottom="8dp">

                    <com.google.android.material.chip.Chip android:id="@+id/chip_accel_auto" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUTO" android:textSize="11sp" />

                    <com.google.android.material.chip.Chip android:id="@+id/chip_accel_cpu" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU" android:textSize="11sp" />

                    <com.google.android.material.chip.Chip android:id="@+id/chip_accel_gpu" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPU" android:textSize="11sp" />

                    <com.google.android.material.chip.Chip android:id="@+id/chip_accel_npu" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NPU" android:textSize="11sp" />
                </com.google.android.material.chip.ChipGroup>

                <!-- ── Priority vlákna pro STT/Diktafon (Fáze B) ── -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚡ Priorita CPU vlákna" android:textColor="#00BCD4" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />

                <com.google.android.material.chip.ChipGroup android:id="@+id/chipgroup_priority_studio" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" android:layout_marginBottom="2dp">

                    <com.google.android.material.chip.Chip android:id="@+id/chip_studio_priority_urgent" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥 Urgentní" android:textSize="11sp" />

                    <com.google.android.material.chip.Chip android:id="@+id/chip_studio_priority_default" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡ Výchozí" android:textSize="11sp" android:checked="true" />

                    <com.google.android.material.chip.Chip android:id="@+id/chip_studio_priority_bg" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌙 Pozadí" android:textSize="11sp" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Varování pro URGENT na slabém HW -->
                <TextView android:id="@+id/tv_studio_priority_warning" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚠️ Urgentní: Max CPU freq. Vhodné pro výkonné HW (S24U+). Na slabším HW může způsobit lag UI." android:textColor="#FF9800" android:textSize="11sp" android:layout_marginBottom="8dp" android:visibility="gone" />

                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="180dp" app:cardBackgroundColor="#0A0A0A" app:cardCornerRadius="8dp" app:cardElevation="0dp" android:layout_marginBottom="8dp">
                    <androidx.core.widget.NestedScrollView android:id="@+id/sv_dictaphone_transcript" android:layout_width="match_parent" android:layout_height="match_parent">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView android:id="@+id/tv_dictaphone_transcript" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B0BEC5" android:textSize="15sp" android:lineSpacingExtra="4dp" android:textIsSelectable="true" />
                            <TextView android:id="@+id/tv_dictaphone_partial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Transkripce..." android:textColor="#78909C" android:textSize="15sp" android:lineSpacingExtra="4dp" android:textStyle="italic" />
                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>
                </androidx.cardview.widget.CardView>

                <!-- Transcript Toolbar: Kopírovat / Upravit / Sdílet / AI -->
                <LinearLayout
                    android:id="@+id/ll_transcript_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_transcript_copy"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:text="📋 Kopírovat"
                        android:textSize="11sp"
                        android:textColor="#B0BEC5"
                        app:strokeColor="#444444"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <Space android:layout_width="4dp" android:layout_height="wrap_content" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_transcript_edit"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:text="✏️ Upravit"
                        android:textSize="11sp"
                        android:textColor="#B0BEC5"
                        app:strokeColor="#444444"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <Space android:layout_width="4dp" android:layout_height="wrap_content" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_transcript_share"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:text="📤 Sdílet"
                        android:textSize="11sp"
                        android:textColor="#B0BEC5"
                        app:strokeColor="#444444"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_dictaphone_ai_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="✨ Generovat AI Zápis z porady"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#673AB7"
                    android:visibility="gone" />

                <!-- NLP Quick panel: progress + výsledek (buttony přidávány programaticky do ll_transcript_toolbar) -->
                <ProgressBar
                    android:id="@+id/progress_nlp_studio"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:indeterminate="true"
                    android:progressTint="#673AB7"
                    android:visibility="gone"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_nlp_result_studio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:text=""
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:background="#0A673AB7"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"
                    android:focusable="true" />

                <!-- Placeholder fields for NLP Studio buttons (filled programmatically) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nlp_summarize_studio"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nlp_proofread_studio"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nlp_translate_studio"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nlp_rewrite_studio"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nlp_sentiment_studio"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- DSP Settings (Kompaktní) -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pokročilé DSP Filtry" android:textColor="#4CAF50" android:textSize="12sp" android:textStyle="bold" android:paddingTop="8dp" android:paddingBottom="4dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_aec" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="AEC" android:textColor="#888" android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_ns" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="NS" android:textColor="#888" android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_agc" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="AGC" android:textColor="#888" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_raw_bypass" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="RAW Bypass" android:textColor="#D32F2F" android:textSize="12sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_dual_stream" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Mód B" android:textColor="#00BCD4" android:textSize="12sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_mixer"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🎛️ Otevřít Mixážní Pult"
                    android:textColor="#00BCD4"
                    app:strokeColor="#00BCD4" />

                <!-- File Manager RecyclerView -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Uložené Nahrávky" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_dictaphone_files" android:layout_width="match_parent" android:layout_height="200dp" android:background="#0A0A0A" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Karta 2: Zrcadlení databáze AI Modelů -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_ai_models" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp" app:cardBackgroundColor="#121212" app:cardCornerRadius="12dp" app:strokeColor="#5E35B1" app:strokeWidth="1dp" app:layout_constraintTop_toBottomOf="@id/card_dsp_record">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aktivní Modely (Zrcadleno ze Settings)" android:textColor="#B39DDB" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="8dp" />

                <TextView android:id="@+id/tv_active_stt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STT: Nenačteno" android:textColor="@android:color/white" android:textSize="14sp" android:paddingVertical="4dp" />

                <TextView android:id="@+id/tv_active_tts" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TTS: Nenačteno" android:textColor="@android:color/white" android:textSize="14sp" android:paddingVertical="4dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_select_stt" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Vybrat STT" app:strokeColor="#5E35B1" android:textColor="#B39DDB" />

                    <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_select_tts" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Vybrat TTS" app:strokeColor="#5E35B1" android:textColor="#B39DDB" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Karta 3: ZipVoice Klonování -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_zipvoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="16dp" app:cardBackgroundColor="#121212" app:cardCornerRadius="12dp" app:strokeColor="#00BCD4" app:strokeWidth="1dp" app:layout_constraintTop_toBottomOf="@id/card_ai_models">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Klonování Hlasu (ZipVoice)" android:textColor="#00BCD4" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="8dp" />

                <TextView android:id="@+id/tv_zipvoice_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aktivní Prompt: Žádný (Default AI)" android:textColor="#888888" android:textSize="14sp" android:paddingBottom="4dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙️ Jadra:" android:textColor="#00BCD4" android:textSize="14sp" android:layout_marginEnd="4dp" />
                    <Spinner android:id="@+id/spinner_zipvoice_threads" android:layout_width="wrap_content" android:layout_height="48dp" android:backgroundTint="#00BCD4" />
                    <TextView android:id="@+id/tv_zipvoice_threads_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#00BCD4" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="2dp" android:layout_marginEnd="8dp" android:layout_gravity="center_vertical" android:text="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prio:" android:textColor="#00BCD4" android:textSize="14sp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
                    <Spinner android:id="@+id/spinner_zipvoice_priority" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="#00BCD4" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Hz:" android:textColor="#00BCD4" android:textSize="14sp" android:layout_marginStart="8dp" android:layout_marginEnd="4dp" />
                    <Spinner android:id="@+id/spinner_zipvoice_sample_rate" android:layout_width="wrap_content" android:layout_height="48dp" android:backgroundTint="#00BCD4" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_zipvoice_thermal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ThermalGuard™ (Adaptivní chlazení)" android:textColor="#888888" android:textSize="14sp" android:checked="true" app:thumbTint="#924e4eff" app:trackTint="#3300BCD4" android:layout_marginBottom="12dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Max znaků na chunk (0 = Vše):" android:textColor="#00BCD4" android:textSize="14sp" android:layout_marginEnd="8dp" />
                    <EditText android:id="@+id/et_zipvoice_chunk_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inputType="number" android:hint="např. 1500" android:textColorHint="#555" android:textColor="@android:color/white" android:textSize="14sp" />
                </LinearLayout>

                <EditText android:id="@+id/et_zipvoice_ref_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Referenční text nahrávky" android:textColorHint="#555" android:textColor="@android:color/white" android:textSize="14sp" android:paddingBottom="8dp" />

                <EditText android:id="@+id/et_zipvoice_test_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Text k vygenerování (Klonování)" android:textColorHint="#555" android:textColor="@android:color/white" android:textSize="14sp" android:paddingBottom="8dp" />

                <!-- Tlačítka pro referenci -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="12dp">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_zipvoice_record_mic_10s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mic 10s" android:textColor="@android:color/white" android:backgroundTint="#D32F2F" />
                    <Space android:layout_width="4dp" android:layout_height="wrap_content" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_zipvoice_record_mic_dyn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mic 3m" android:textColor="@android:color/white" android:backgroundTint="#C2185B" />

                    <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_zipvoice_import" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Import" android:textColor="@android:color/white" android:backgroundTint="#00838F" />

                    <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                    <ImageButton android:id="@+id/btn_zipvoice_play_ref" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_media_play" android:background="@android:color/transparent" app:tint="#4CAF50" />
                </LinearLayout>

                <!-- Tlačítka pro generování a uložení -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_zipvoice_test" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔊 Přečíst" android:textColor="@android:color/white" android:backgroundTint="#00BCD4" />

                    <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_zipvoice_save_clone" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="💾 Uložit (WAV)" android:textColor="@android:color/white" android:backgroundTint="#FF9800" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Karta 4: Správce Stop a Import/Export (Média & SRT) -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_media_manager" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="16dp" app:cardBackgroundColor="#121212" app:cardCornerRadius="12dp" app:strokeColor="#FFB300" app:strokeWidth="1dp" app:layout_constraintTop_toBottomOf="@id/card_zipvoice">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Správce Stop &amp; Nástroje" android:textColor="#FFB300" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_import_media" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:backgroundTint="#FF8F00" android:text="Import &amp; Ořez (Video/Audio)" android:textColor="@android:color/white" />

                    <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_generate_srt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:backgroundTint="#1976D2" android:text="Generovat SRT Editor" android:textColor="@android:color/white" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_audio_files" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="8dp" android:background="#0A0A0A" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
