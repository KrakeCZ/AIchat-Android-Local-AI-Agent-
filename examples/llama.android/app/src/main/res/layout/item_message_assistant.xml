<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:gravity="start"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_assistant_message">

        <TextView
            android:id="@+id/msg_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:paddingBottom="24dp"
            android:paddingEnd="58dp"
            android:textIsSelectable="true"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/tv_translation_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="4dp"
            android:textSize="10sp"
            android:textColor="#00838F"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ll_bubble_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/action_translate_bubble"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Přeložit zprávu (podržení pro změnu jazyka)"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_translate_small"
                android:visibility="gone"
                app:tint="@color/copy_button_tint" />

            <ImageButton
                android:id="@+id/action_copy_bubble"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/msg_copied"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_copy_small"
                android:visibility="gone"
                app:tint="@color/copy_button_tint" />
        </LinearLayout>
    </FrameLayout>

    <ImageButton
        android:id="@+id/action_speak"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_speak"
        android:src="@drawable/ic_speaker_24"
        android:padding="12dp" />
</LinearLayout>
