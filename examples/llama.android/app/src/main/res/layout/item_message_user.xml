<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:gravity="end">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_user_message">

        <!-- Attachment preview (obrázek/video thumbnail/audio ikona).
             Výchozí GONE = zero layout cost pokud není příloha.
             centerCrop s max šířkou 280dp brání nafukování bubliny. -->
        <ImageView
            android:id="@+id/attachment_preview"
            android:layout_width="280dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="4dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <!-- Text zprávy pod náhledem -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/msg_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:paddingBottom="24dp"
                android:paddingEnd="30dp"
                android:textIsSelectable="true"
                android:textColor="@android:color/white" />

            <ImageButton
                android:id="@+id/action_copy_bubble"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/msg_copied"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_copy_small"
                android:visibility="gone"
                app:tint="@color/copy_button_tint" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
