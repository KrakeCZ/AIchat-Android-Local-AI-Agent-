<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeColor="#333333"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Řádek: index + časy + delete tlačítko -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_srt_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_time_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:text="00:00:00,000"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:maxLines="1"
                android:inputType="time" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ➔ "
                android:textColor="#888888"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_time_end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:text="00:00:02,500"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:gravity="end"
                android:maxLines="1"
                android:inputType="time" />

            <ImageButton
                android:id="@+id/btn_srt_delete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#F44336"
                android:contentDescription="Smazat blok" />
        </LinearLayout>

        <!-- Text titulku -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_srt_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@null"
            android:hint="Text titulku..."
            android:textColorHint="#555555"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:inputType="textMultiLine" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
