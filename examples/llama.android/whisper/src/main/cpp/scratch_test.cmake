cmake_minimum_required(VERSION 3.22)
include(ExternalProject)
macro(ExternalProject_Add _name)
    if("${_name}" STREQUAL "vulkan-shaders-gen")
        message(STATUS "Skipped vulkan-shaders-gen")
    else()
        _ExternalProject_Add(${ARGV})
    endif()
endmacro()

macro(add_custom_command)
    set(_skip_cmd OFF)
    foreach(_arg IN LISTS ARGV)
        if("${_arg}" MATCHES "vulkan-shaders-gen")
            set(_skip_cmd ON)
        endif()
    endforeach()
    if(_skip_cmd)
        message(STATUS "Skipped add_custom_command")
    else()
        _add_custom_command(${ARGV})
    endif()
endmacro()

ExternalProject_Add(vulkan-shaders-gen)
add_custom_command(OUTPUT fake.txt COMMAND vulkan-shaders-gen)
add_custom_command(OUTPUT real.txt COMMAND echo "real")
